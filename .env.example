VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
OPENWEATHER_API_KEY=
AVIATIONSTACK_API_KEY=

# Google OAuth via Supabase Auth
# 1. Google Cloud Console > OAuth client > Authorized redirect URI:
#    https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
#    (use the Supabase callback here — NOT your app URL)
# 2. Supabase Dashboard > Authentication > Providers > Google:
#    paste Client ID and Client Secret from Google Cloud
# 3. Supabase Dashboard > Authentication > URL Configuration > Redirect URLs:
#    http://localhost:5173/auth/callback
#    https://your-production-domain/auth/callback
# Optional frontend flag (default true when unset):
VITE_OAUTH_GOOGLE_ENABLED=true
# Optional override for the app return URL (defaults to {origin}/auth/callback):
# VITE_OAUTH_REDIRECT_URL=http://localhost:5173/auth/callback
