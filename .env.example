VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
OPENWEATHER_API_KEY=
AVIATIONSTACK_API_KEY=

# OAuth Google via Supabase Auth
# 1. Enable Google in Supabase Dashboard > Authentication > Providers
# 2. Add redirect URL in Supabase: http://localhost:5173/auth/callback (and production URL)
# 3. Google Cloud Console: put Client ID & Client Secret ONLY in Supabase (never here)
# Optional frontend flag (default true when unset):
VITE_OAUTH_GOOGLE_ENABLED=true
# Optional override for OAuth return URL (defaults to {origin}/auth/callback):
# VITE_OAUTH_REDIRECT_URL=http://localhost:5173/auth/callback
